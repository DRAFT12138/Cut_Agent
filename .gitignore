# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.kdbx
credentials.json
secrets.json

# Web 前端（Phase 0）：源码入库，构建产物与依赖不入库
web/node_modules/
web/dist/
# The release UI is deliberately checked in as Python package data. Its source
# remains web/; refresh it with tools/build_web_assets.py.
!src/cut_agent/web_dist/
!src/cut_agent/web_dist/**
web/*.tsbuildinfo
web/.test-build/

# Node / open-webSearch 工具产物
tools/open-webSearch/node_modules/
tools/open-webSearch/build/
tools/open-webSearch/dist/

# ffmpeg 发行包（可重新下载）
tools/ffmpeg-release-essentials.zip
tools/ffmpeg-*/
open-webSearch.zip

# 浏览器 profile（含缓存/cookies，勿入库）
.chrome-profile/

# 运行产物
work/
output/
owx_tmp/
*.log
*.sqlite
*.sqlite3

# 生成的示例素材（可用 make_sample.py 重新生成；保留 _thumbs 之外的原文件也不入库）
sample_media/*
!sample_media/.gitkeep
